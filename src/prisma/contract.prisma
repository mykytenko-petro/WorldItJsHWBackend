// use prisma-8
model Post {
  id         Int       @id @default(autoincrement())

  title      String
  content    String
  author     String

  categoryId Int?
  category   Category? @relation(fields:[categoryId], references:[id])

  userId     Int?
  user       User?     @relation(fields:[userId], references:[id])

  @@map("post")
}

model Category {
  id    Int    @id @default(autoincrement())

  name  String @unique

  posts Post[]

  @@map("category")
}

model User {
  id       Int    @id @default(autoincrement())

  email    String @unique
  password String

  posts    Post[]
  sessions Session[]

  @@map("user")
}

model Session {
  id        Int      @id @default(autoincrement())

  tokenHash String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  
  userId    Int
  user      User     @relation(fields:[userId], references:[id])

  @@map("session")
}
